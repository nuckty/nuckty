{
  "extends": "./config-ts.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "../src/**/*.ts",
    "../src/test/**/*.test.ts",
    "../blocks/**/*.nu.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist"
  ]
}
