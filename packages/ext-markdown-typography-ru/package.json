{
    "name": "@nuckty/ext-markdown-typography-ru",
    "version": "1.0.0-rc.0",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuckty/nuckty.git",
        "directory": "packages/ext-markdown-typography-ru"
    },
    "homepage": "https://nuckty.com/ext/markdown/typography-ru",
    "bugs": {
        "url": "https://github.com/nuckty/nuckty/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "description": "nuckty markdown-extension: Russian em-dash + nbsp typography",
    "keywords": [
        "nuckty",
        "nuckty-extension",
        "nuckty-markdown-extension"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p config/config-ts.json",
        "test": "tsx --test src/test/**/*.test.ts",
        "lint": "tsc --noEmit -p config/config-ts-test.json",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/mdast": "4.0.4",
        "remark-parse": "11.0.0",
        "unified": "11.0.5",
        "unist-util-visit": "5.1.0"
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "@nuckty/core": "1.0.0-rc.0"
    },
    "author": {
        "name": "Vitaly Harisov",
        "email": "vitaly@harisov.name"
    },
    "engines": {
        "node": ">=24"
    }
}
