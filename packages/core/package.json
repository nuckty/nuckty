{
    "name": "@nuckty/core",
    "version": "1.0.0-rc.0",
    "description": "All static site generators suck. This one just sucks less. BEMJSON template engine, programmatic pipeline, multi-target builds.",
    "keywords": [
        "nuckty",
        "static-site-generator",
        "bemjson",
        "markdown",
        "ssg"
    ],
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuckty/nuckty.git",
        "directory": "packages/core"
    },
    "homepage": "https://nuckty.com",
    "bugs": {
        "url": "https://github.com/nuckty/nuckty/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "bin": {
        "nuckty": "dist/bin/nuckty.js"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "rm -rf dist && npm run build:types && npm run build:js",
        "build:types": "tsc -p config/config-ts-types.json",
        "build:js": "tsup --config config/config-tsup.ts",
        "build:dev": "tsc --noEmit -p config/config-ts-test.json",
        "test": "npm run build && npm run test:unit",
        "test:unit": "node --test --import tsx src/test/*.test.ts src/test/integration/*.test.ts config/*.test.mjs",
        "test:core": "node config/run-core-tests.mjs",
        "test:coverage": "npm run build && rm -rf .coverage && NODE_V8_COVERAGE=$PWD/.coverage node --test --import ./config/register-test-source.mjs src/test/*.test.ts src/test/integration/*.test.ts config/*.test.mjs && node config/filter-coverage.mjs && c8 report --temp-directory .coverage-source --all --exclude-after-remap --include 'src/**/*.ts' --exclude 'src/test/**' --exclude 'src/**/*.d.ts' --exclude 'src/bem/template-types.ts' --exclude 'src/index.ts' --exclude 'src/browser.ts' --reporter text --reporter json-summary --reports-dir coverage && node config/check-coverage.mjs coverage/coverage-summary.json",
        "lint": "tsc --noEmit -p config/config-ts-test.json && npm run lint:markdown",
        "prepack": "npm run build",
        "lint:markdown": "node config/lint-markdown.mjs",
        "lint:fix": "npm run lint:markdown -- --fix"
    },
    "dependencies": {
        "entities": "7.0.0",
        "esbuild": "0.28.2",
        "lightningcss": "1.33.0",
        "mdast-util-to-string": "4.0.0",
        "remark-directive": "4.0.0",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "unified": "11.0.5",
        "@types/mdast": "4.0.4"
    },
    "devDependencies": {
        "c8": "12.0.0",
        "tsup": "8.5.1",
        "parse5": "8.0.1"
    },
    "author": {
        "name": "Vitaly Harisov",
        "email": "vitaly@harisov.name"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./browser": {
            "types": "./dist/browser.d.ts",
            "default": "./dist/browser.js"
        },
        "./package.json": "./package.json"
    }
}
