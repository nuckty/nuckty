{
    "name": "@nuckty/ext-block-root",
    "version": "1.0.0-rc.1",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuckty/nuckty.git",
        "directory": "packages/ext-block-root"
    },
    "homepage": "https://nuckty.com/ext/block/root",
    "bugs": {
        "url": "https://github.com/nuckty/nuckty/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "description": "nuckty block-extension: the root page wrapper block (<html>/<head>/<body>)",
    "keywords": [
        "nuckty",
        "nuckty-extension",
        "nuckty-block-extension"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "blocks"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc -p config/config-ts.json",
        "test": "tsx --test src/test/**/*.test.ts",
        "lint": "tsc --noEmit -p config/config-ts-test.json",
        "prepack": "npm run build"
    },
    "devDependencies": {},
    "peerDependencies": {
        "@nuckty/core": "1.0.0-rc.1"
    },
    "author": {
        "name": "Vitaly Harisov",
        "email": "vitaly@harisov.name"
    },
    "engines": {
        "node": ">=24"
    }
}
