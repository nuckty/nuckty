{
    "name": "@nuckty/ext-markdown-video",
    "version": "1.0.0-rc.1",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuckty/nuckty.git",
        "directory": "packages/ext-markdown-video"
    },
    "homepage": "https://nuckty.com/ext/markdown/video",
    "bugs": {
        "url": "https://github.com/nuckty/nuckty/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "description": "nuckty markdown-extension: video embed via @[provider](id)",
    "keywords": [
        "nuckty",
        "nuckty-extension",
        "nuckty-markdown-extension"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p config/config-ts.json",
        "test": "node --import tsx --test src/test/*.test.ts",
        "lint": "tsc --noEmit -p config/config-ts-test.json",
        "prepack": "npm run build",
        "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include='blocks/**/*.ts' --test-coverage-exclude='src/test/**' --test-coverage-lines=98 --test-coverage-branches=89 --test-coverage-functions=99 src/test/*.test.ts"
    },
    "devDependencies": {
        "@types/mdast": "4.0.4",
        "remark-parse": "11.0.0",
        "unified": "11.0.5"
    },
    "files": [
        "dist",
        "blocks"
    ],
    "peerDependencies": {
        "@nuckty/core": "1.0.0-rc.1"
    },
    "author": {
        "name": "Vitaly Harisov",
        "email": "vitaly@harisov.name"
    },
    "engines": {
        "node": ">=24"
    }
}
