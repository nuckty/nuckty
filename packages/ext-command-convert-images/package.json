{
    "name": "@nuckty/ext-command-convert-images",
    "version": "1.0.0-rc.3",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nuckty/nuckty.git",
        "directory": "packages/ext-command-convert-images"
    },
    "homepage": "https://nuckty.com/ext/command/convert-images",
    "bugs": {
        "url": "https://github.com/nuckty/nuckty/issues"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "description": "nuckty command-extension: encode content PNG/JPEG to AVIF and WebP via sharp",
    "keywords": [
        "nuckty",
        "nuckty-extension",
        "nuckty-command-extension"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p config/config-ts.json",
        "test": "node --import tsx --test src/test/*.test.ts",
        "lint": "tsc --noEmit -p config/config-ts-test.json",
        "prepack": "npm run build",
        "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/test/**' --test-coverage-lines=97 --test-coverage-branches=93 --test-coverage-functions=95 src/test/*.test.ts"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "sharp": "0.35.5"
    },
    "devDependencies": {},
    "peerDependencies": {
        "@nuckty/core": "1.0.0-rc.3"
    },
    "author": {
        "name": "Vitaly Harisov",
        "email": "vitaly@harisov.name"
    },
    "engines": {
        "node": ">=24"
    }
}
