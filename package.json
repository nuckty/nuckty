{
    "name": "@nuckty/monorepo",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "packages/core",
        "packages/*",
        "demo"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "npm run build -w @nuckty/core && npm rebuild @nuckty/core && npm run build --workspaces --if-present",
        "lint": "npm run lint --workspaces --if-present && openspec validate --all --strict",
        "test": "npm run test --workspaces --if-present",
        "logo:optimize": "svgo --config config/config-svgo.js --folder logo --exclude \"_(source|grid)[.]svg$\" --eol lf --final-newline",
        "changeset": "changeset",
        "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund --registry=https://registry.npmjs.org",
        "release": "npm run build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@fission-ai/openspec": "1.12.0",
        "@types/node": "24.13.3",
        "esbuild": "0.28.2",
        "svgo": "4.1.0",
        "tsx": "4.23.12",
        "typescript": "7.0.2"
    },
    "overrides": {
        "tsup": {
            "esbuild": "$esbuild"
        }
    }
}
